# Copy outside the repository, restrict access, then replace every SET_* value privately.
# Defaults below remain loopback-only. Change bind/domain/ports only after hosting approval.
TAPE_BETA_BIND=127.0.0.1
TAPE_BETA_HOST=localhost
TAPE_BETA_HTTP_PORT=8088
TAPE_BETA_HTTPS_PORT=8443
TAPE_PUBLIC_ORIGIN=https://localhost:8443
TAPE_IMAGE_TAG=tape-beta:SET_RELEASE_COMMIT
TAPE_POSTGRES_PASSWORD=SET_OWNER_PASSWORD
TAPE_ACCOUNTS_PASSWORD=SET_DISTINCT_RUNTIME_PASSWORD
TAPE_MAIL_FROM=SET_VERIFIED_SENDER
TAPE_IDENTITY_MAIL_KEY=SET_PERSISTENT_BASE64_KEY
TAPE_OPS_TOKEN=SET_RANDOM_OPERATIONS_TOKEN
TAPE_SMTP_USER=SET_BREVO_SMTP_LOGIN
TAPE_SMTP_PASSWORD=SET_BREVO_SMTP_KEY
TAPE_REGISTRATION_MODE=CLOSED
TAPE_REGISTRATION_ALLOWLIST=
TAPE_BACKUP_RECIPIENT=SET_OFFLINE_AGE_PUBLIC_RECIPIENT
